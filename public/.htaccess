# Force HTTPS before anything else is served. HSTS is only delivered over
# TLS, so a first plain-HTTP visit would otherwise be served (and can be
# downgraded/MITM'd). The canonical host is hardcoded on purpose — deriving
# it from %{HTTP_HOST} would make this an open redirect. The ACME challenge
# path is excluded so certificate renewal keeps working.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule ^ https://jajat.godieboy.com%{REQUEST_URI} [L,R=301]
</IfModule>

# CSP: `cspNoncePlugin()` (vite.config.ts) injects the per-build
# `'nonce-<build>'` into `script-src`/`script-src-elem` and
# `style-src`/`style-src-elem` when it writes `dist/.htaccess` — the same
# nonce the meta tag uses. Both policies must allow the app's inline scripts,
# because they are enforced as an intersection; without the nonce this header
# blocked them (theme pre-mount IIFE + runtime JSON-LD). Styles additionally
# pin the SHA-256 hash of Google GSI's injected stylesheet; see index.html
# for why that sheet is hashed while Radix's uses the nonce.
<IfModule mod_headers.c>
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com https://*.gstatic.com; script-src-elem 'self' https://accounts.google.com https://*.gstatic.com; script-src-attr 'none'; style-src 'self' 'sha256-RU4sU0AaS8IBGZx8XrGt/pa9A5SLA3dQszGeqT5L3Kw='; style-src-elem 'self' 'sha256-RU4sU0AaS8IBGZx8XrGt/pa9A5SLA3dQszGeqT5L3Kw='; style-src-attr 'none'; img-src 'self' data: https://godieboy.com; font-src 'self' data:; connect-src 'self' https://jajat.godieboy.com https://accounts.google.com https://oauth2.googleapis.com https://www.googleapis.com https://gmail.googleapis.com https://generativelanguage.googleapis.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-src https://accounts.google.com; worker-src 'self'; manifest-src 'self';"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # `Header always unset X-Powered-By` covers the PHP banner if the host
    # ever enables expose_php. The `Server:` banner cannot be removed with
    # mod_headers (verified against Apache 2.4 in a local container) — it
    # needs `ServerTokens Prod` (and `ServerSignature Off`) in the vhost,
    # which are server-config-only directives.
    Header always unset X-Powered-By
</IfModule>