# Security header: allow Google OAuth popup to check window.closed without COOP errors
# 'same-origin-allow-popups' is the recommended value for OAuth popup flows
Header set Cross-Origin-Opener-Policy "same-origin-allow-popups"

RewriteEngine On
# Proteger archivos sensibles
<Files ".env">
    Order allow,deny
    Deny from all
</Files>
<Files "config.php">
    Order allow,deny
    Deny from all
</Files>

# Nothing in this tree is public except the front controller. Static infra
# files were being served verbatim: /api/composer.lock (196 KB, full
# dependency tree), composer.json, phpunit.xml, phpstan.neon, README.md,
# .env.example and vendor/*. Only index.php may run; everything else is
# denied.
<FilesMatch "(^\.|^(?!index\.php$).*\.php$|\.(json|lock|neon|xml|md|map|ya?ml|sqlite|db|sh|dist)$)">
    Order allow,deny
    Deny from all
</FilesMatch>

# Evita que se apliquen reglas si el archivo o carpeta real existe
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Manda todo lo que no exista a index.php dentro de /api
RewriteRule ^(.*)$ index.php [L,QSA]
